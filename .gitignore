# macOS
.DS_Store

# Python
backend/venv/
__pycache__/
*.pyc

# Xcode
ios/DerivedData/
ios/build/
**/xcuserdata/
*.xcuserstate

# Build output for the vendored Swifter package. Xcode creates these inside the package when it
# resolves and builds it; the sources next to them are vendored and tracked, the output is not.
# Both spellings appear: SwiftPM writes `.build`, Xcode's own build system writes `build`.
ios/VVDemus/Vendor/Swifter/.build/
ios/VVDemus/Vendor/Swifter/build/

# Throwaway git worktrees created for agent runs. They are checkouts of this repo, so tracking
# them would commit a copy of the tree into the tree. The rest of `.claude/` is real project
# configuration — `cleanup-keep.txt` is meant to be edited, see CLAUDE.md — and stays tracked.
.claude/worktrees/

# This machine's signing team and bundle id. The committed Signing.xcconfig holds a
# placeholder team and a deliberately invalid bundle id, and optionally includes this; see
# the comments in it.
ios/Config/Signing.local.xcconfig

# Generated from project.yml by `xcodegen generate` — a build artifact, not a source file.
#
# Tracked, it was the second way the two developers' signing settings kept overwriting each
# other: XcodeGen writes this file from project.yml, but *Xcode* rewrites it too whenever it
# "fixes" signing for you, baking in whichever DEVELOPMENT_TEAM that machine happens to have.
# It shipped `DEVELOPMENT_TEAM = FTVNWWU5J2` for exactly that reason. Untracked, Xcode can
# scribble in it freely and git never sees it.
#
# Run `xcodegen generate` in ios/ after cloning, and after any change to project.yml.
ios/VVDemus.xcodeproj/
